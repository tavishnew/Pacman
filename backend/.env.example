# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# Note: SQLite is ephemeral on Render's free tier. For persistent data on production,
# attach a Render persistent disk or migrate to a managed database (Postgres, etc).
DATABASE_PATH=./pacman.db

# JWT Authentication
# Use a strong random string >= 32 chars in production. The server refuses to start
# in production if JWT_SECRET is missing, too short, or left at the dev placeholder.
JWT_SECRET=your-super-secret-key-change-in-production

# CORS Configuration
# Comma-separated list of allowed frontend origins. FRONTEND_URL is also honored
# as a single fallback for back-compat with older deployments.
FRONTEND_URLS=https://YOUR-VERCEL-FRONTEND.vercel.app
FRONTEND_URL=https://YOUR-VERCEL-FRONTEND.vercel.app
